FROM --platform=linux/amd64 cachyos/cachyos:latest

# Bootstrap mode for the test run. The first token selects the mode,
# anything after it is forwarded to ansible-playbook:
#     --check --diff       playbook check without modifying the container (default)
#     --check --tags <r>   check a single tagged role
#     --unattended         full end-to-end provisioning, including kaji's
#                          AUR installs (Claude/human gates skipped, all
#                          cryptographic checks enforced)
# Example:
#     docker build --build-arg HANZO_TEST_ARGS="--unattended" -f tests/Containerfile -t hanzo:test .
ARG HANZO_TEST_ARGS="--check --diff"

RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm python git curl sudo base-devel

# Non-root user with passwordless sudo for realistic testing
RUN useradd -m -G wheel testuser && \
    echo "testuser ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# The container provisions through bin/bootstrap.sh exactly as a
# production machine would. The repo is pre-copied to bootstrap's clone
# path so the code under review is tested; HANZO_SKIP_SYNC keeps
# bin/hanzo from resetting it to origin/main, and the HANZO_* identity
# env vars exercise bootstrap's unattended configuration path.
COPY --chown=testuser:testuser . /home/testuser/.local/src/hanzo

USER testuser
WORKDIR /home/testuser/.local/src/hanzo
ENV PATH="/home/testuser/.local/bin:${PATH}"

# When the build context is a git worktree, .git is a pointer file to
# a path outside the container — replace it with a real repository so
# bootstrap detects the existing checkout instead of cloning over it.
RUN [ -d .git ] || { rm -f .git; git init -q; }
ENV HANZO_SKIP_SYNC=1
ENV HANZO_FULLNAME="Test User"
ENV HANZO_EMAIL="test@example.com"

RUN bash bin/bootstrap.sh $HANZO_TEST_ARGS

# Full builds run kaji a second time: with all AUR packages installed
# and the state file populated, this exercises the idempotent re-run
# path and a non-vacuous foreign-package check (including the -debug
# split handling) — the first run only ever sees an empty system.
RUN case "$HANZO_TEST_ARGS" in \
      --unattended*) HANZO_AUR_UNATTENDED=1 kaji ;; \
      *) echo "check build — kaji re-run skipped" ;; \
    esac
