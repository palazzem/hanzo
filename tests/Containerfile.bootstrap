FROM --platform=linux/amd64 cachyos/cachyos:latest

# Exercises the bootstrap → hanzo lifecycle end-to-end with a hermetic
# origin (local bare repo) standing in for github.com. The existing
# `tests/Containerfile` already covers the playbook itself, so this
# stage uses `hanzo --list-tags` to exercise the every-run glue (sync,
# Galaxy refresh, ansible-playbook invocation) without re-running the
# roles.

RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm python git curl sudo base-devel paru

RUN useradd -m -G wheel testuser && \
    echo "testuser ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Stage the source as a hermetic origin. The container has no network
# path to github.com, so HANZO_REPO is overridden to point at a local
# bare repo created from the COPY'd source.
COPY --chown=testuser:testuser . /home/testuser/hanzo-src

USER testuser
WORKDIR /home/testuser

ENV HANZO_DIR=/home/testuser/.local/src/hanzo \
    PATH=/home/testuser/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Pre-seed user config so the interactive prompt path is skipped.
RUN mkdir -p /home/testuser/.config/hanzo && \
    printf 'hanzo_fullname: "Test User"\nhanzo_email: "test@example.com"\n' \
      > /home/testuser/.config/hanzo/config.yml

# Build the hermetic origin at /tmp/origin.git, with the COPY'd source
# pushed as `main`. The bare repo lives outside the future worktree,
# so `git clean -fdx` in hanzo cannot touch it.
# We strip any inherited `.git` first (the build context may be a
# worktree, in which case COPY brings in a `.git` *file* pointing at a
# path that doesn't exist inside the container).
RUN rm -rf /home/testuser/hanzo-src/.git && \
    git init --bare /tmp/origin.git && \
    cd /home/testuser/hanzo-src && \
    git init -q -b main && \
    git config user.email test@example.com && \
    git config user.name Test && \
    git add . && \
    git commit -q -m "initial" && \
    git remote add origin file:///tmp/origin.git && \
    git push -q -u origin main && \
    git -C /tmp/origin.git symbolic-ref HEAD refs/heads/main

# Test 1 — Bootstrap idempotency + symlink correctness.
# Bootstrap is invoked twice; after each run the same invariants must
# hold (assertions in tests/assert-bootstrap-state.sh). `--list-tags`
# makes the final ansible-playbook call a no-op listing — the playbook
# itself is covered by tests/Containerfile.
RUN export HANZO_REPO="file:///tmp/origin.git" && \
    bash /home/testuser/hanzo-src/bin/bootstrap.sh --list-tags && \
    bash /home/testuser/hanzo-src/tests/assert-bootstrap-state.sh

RUN export HANZO_REPO="file:///tmp/origin.git" && \
    bash /home/testuser/hanzo-src/bin/bootstrap.sh --list-tags && \
    bash /home/testuser/hanzo-src/tests/assert-bootstrap-state.sh

# Test 2 — Forced sync clears tracked, untracked, and gitignored drift,
# and the Galaxy refresh actually reinstalls deleted collections.
# Drift sequence (junk branch first, then dirt on top — keeps the dirt
# off `main` so the assertion that `main` matches origin holds):
#   - check out a junk branch
#   - modify a tracked file
#   - add an untracked file
#   - add a gitignored file (verifies `git clean -fdx` removes -x'd paths)
#   - delete the kewlfft.aur collection cache (verifies Galaxy refresh)
RUN cd "$HANZO_DIR" && \
    git checkout -q -b junk && \
    echo "BROKEN" >> playbook.yml && \
    touch "$HANZO_DIR/scratch.txt" && \
    mkdir -p "$HANZO_DIR/.venv" && \
    touch "$HANZO_DIR/.venv/marker" && \
    rm -rf "$HOME/.ansible/collections/ansible_collections/kewlfft" && \
    hanzo --list-tags && \
    test "$(git -C "$HANZO_DIR" rev-parse --abbrev-ref HEAD)" = main && \
    ! grep -q BROKEN "$HANZO_DIR/playbook.yml" && \
    test ! -e "$HANZO_DIR/scratch.txt" && \
    test ! -e "$HANZO_DIR/.venv/marker" && \
    test -d "$HOME/.ansible/collections/ansible_collections/kewlfft/aur"

# Test 3 — Self-reexec when the wrapper script is rewritten mid-sync.
# Push a modified bin/hanzo to origin (adds a sentinel log line that
# only the *new* wrapper emits). When `hanzo --list-tags` runs, the
# sync block rewrites the wrapper, the sha256 comparison detects the
# change, and the script re-execs itself with __HANZO_INTERNAL_RESYNCED=1.
# Asserting the sentinel appears in output proves the new wrapper
# actually executed.
RUN tmp=$(mktemp -d) && \
    git clone -q file:///tmp/origin.git "$tmp/origin-clone" && \
    git -C "$tmp/origin-clone" config user.email test@example.com && \
    git -C "$tmp/origin-clone" config user.name Test && \
    sed -i 's|log_info "Refreshing Ansible collections|log_info "REEXEC_SENTINEL_v2"\n    log_info "Refreshing Ansible collections|' \
        "$tmp/origin-clone/bin/hanzo" && \
    git -C "$tmp/origin-clone" commit -q -am "bump wrapper for re-exec test" && \
    git -C "$tmp/origin-clone" push -q origin main && \
    out=$(hanzo --list-tags 2>&1) && \
    echo "$out" | grep -q "hanzo wrapper updated" && \
    echo "$out" | grep -q "REEXEC_SENTINEL_v2" && \
    rm -rf "$tmp"

# Test 4 — Network failure aborts before mutating the checkout.
# Stage drift, point origin at an unreachable host, run hanzo and
# assert (a) non-zero exit, (b) the failure message names a fetch
# problem, (c) the drift survived — proving abort happened before
# `checkout -f`. No origin-URL cleanup follows: this is the last test.
RUN cd "$HANZO_DIR" && \
    echo "STILL_BROKEN" >> playbook.yml && \
    git remote set-url origin https://127.0.0.1:1/nope.git && \
    out=$(hanzo --list-tags 2>&1) ; rc=$? ; \
    test $rc -ne 0 && \
    echo "$out" | grep -qE "fetch|Could not (resolve|connect)|Connection refused" && \
    grep -q STILL_BROKEN "$HANZO_DIR/playbook.yml"
