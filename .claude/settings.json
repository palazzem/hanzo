{
  "permissions": {
    "deny": [
      "Bash(ansible)",
      "Bash(ansible *)",
      "Bash(ansible-playbook)",
      "Bash(ansible-playbook *)",
      "Bash(ansible-pull)",
      "Bash(ansible-pull *)",
      "Bash(ansible-console)",
      "Bash(ansible-console *)",
      "Bash(hanzo)",
      "Bash(hanzo *)",
      "Bash(hanzo-aur)",
      "Bash(hanzo-aur *)",
      "Bash(shelly install)",
      "Bash(shelly install *)",
      "Bash(./bin/bootstrap.sh)",
      "Bash(./bin/bootstrap.sh *)",
      "Bash(bin/bootstrap.sh)",
      "Bash(bin/bootstrap.sh *)",
      "Bash(bash bin/bootstrap.sh)",
      "Bash(bash bin/bootstrap.sh *)",
      "Bash(sh bin/bootstrap.sh)",
      "Bash(sh bin/bootstrap.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-provisioning.sh"
          }
        ]
      }
    ]
  }
}
