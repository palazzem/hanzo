#!/usr/bin/env bash
# Hanzo CLI — runs the Ansible provisioner.
# Usage: hanzo [--check|--ci]

set -euo pipefail

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'
log()  { echo -e "${GREEN}[hanzo]${NC} $1"; }
fail() { echo -e "${RED}[hanzo]${NC} $1" >&2; exit 1; }

MODE="${1:-}"
case "$MODE" in
    ""|--check|--ci) ;;
    *) fail "usage: hanzo [--check|--ci]" ;;
esac

HANZO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
HANZO_AUR_SUDOERS="/etc/sudoers.d/hanzo-aur"

# Belt-and-suspenders cleanup. Ansible's block/always inside
# playbook.yml handles success and task-failure paths; this trap
# covers SIGINT/SIGTERM (Ctrl+C, kill) which ansible cannot. The
# sudoers drop-in installed by the playbook whitelists exactly this
# rm command for the connection user, so cleanup never re-prompts
# for a password — even after ansible's --ask-become-pass cache is
# gone. SIGKILL and power loss remain uncovered (unavoidable).
cleanup() {
    if [[ -f "$HANZO_AUR_SUDOERS" ]]; then
        sudo -n /usr/bin/rm "$HANZO_AUR_SUDOERS" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

cd "$HANZO_DIR"

# A dry run must not mutate the checkout and CI must test the code
# under review — sync only on a real attended run.
if [ -z "$MODE" ]; then
    log "Syncing checkout to origin/main..."
    git fetch origin main
    git reset --hard origin/main
fi

log "Refreshing Ansible collections..."
ansible-galaxy collection install -r requirements.yml

ARGS=()
if [ "$MODE" = "--check" ]; then
    ARGS+=(--check)
fi
# Prompt for sudo only when a terminal is reachable (curl | bash keeps
# stdin on the pipe, so probe /dev/tty instead of stdin) and never in CI.
if [ "$MODE" != "--ci" ] && { : </dev/tty; } 2>/dev/null; then
    ARGS+=(--ask-become-pass)
fi

log "Starting provisioner..."
ansible-playbook playbook.yml "${ARGS[@]}"
