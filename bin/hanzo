#!/usr/bin/env bash
# Hanzo CLI runs the Ansible provisioner.
# Usage: hanzo [--check|--ci] [ansible-playbook-args...]
# Examples:
#   hanzo              # full provisioning run
#   hanzo --check      # dry run (shows what would change)
#   hanzo --ci         # unattended run for container CI

set -euo pipefail

HANZO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# shellcheck source=bin/lib.sh
source "$HANZO_DIR/bin/lib.sh"

# A mode flag must come first; every remaining argument forwards to ansible-playbook.
HANZO_MODE="full"
case "${1:-}" in
    --check|--ci) parse_mode "$1"; shift ;;
esac
mode_banner

HANZO_AUR_SUDOERS="/etc/sudoers.d/hanzo-aur"

# Belt-and-suspenders cleanup. Ansible's block/always inside
# playbook.yml handles success and task-failure paths; this trap
# covers SIGINT/SIGTERM (Ctrl+C, kill) which ansible cannot. The
# sudoers drop-in installed by the playbook whitelists exactly this
# rm command for the connection user, so cleanup never re-prompts
# for a password — even after ansible's --ask-become-pass cache is
# gone. SIGKILL and power loss remain uncovered (unavoidable).
cleanup() {
    if [[ -f "$HANZO_AUR_SUDOERS" ]]; then
        sudo -n /usr/bin/rm "$HANZO_AUR_SUDOERS" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

cd "$HANZO_DIR"

if [ "$HANZO_MODE" = "ci" ]; then
    log_warn "CI mode: skipping checkout sync to origin/main — CI must test the code under review"
else
    log_info "Syncing checkout to origin/main..."
    git fetch origin main
    git reset --hard origin/main
fi

log_info "Refreshing Ansible collections..."
ansible-galaxy collection install -r requirements.yml

HANZO_ANSIBLE_ARGS=()
if [ "$HANZO_MODE" = "check" ]; then
    HANZO_ANSIBLE_ARGS+=(--check)
fi
# CI runs unattended; elsewhere the sudo prompt needs a terminal to read from.
if [ "$HANZO_MODE" != "ci" ] && has_tty; then
    HANZO_ANSIBLE_ARGS+=(--ask-become-pass)
fi

log_info "Starting provisioner..."
ansible-playbook playbook.yml ${HANZO_ANSIBLE_ARGS[@]+"${HANZO_ANSIBLE_ARGS[@]}"} "$@"
