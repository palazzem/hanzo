#!/usr/bin/env bash
# Hanzo CLI — runs the Ansible provisioner.
# Usage: hanzo [--check|--ci]

set -euo pipefail

ANSIBLE_CORE_VERSION="2.21.3"

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'
log()  { echo -e "${GREEN}[hanzo]${NC} $1"; }
fail() { echo -e "${RED}[hanzo]${NC} $1" >&2; exit 1; }

MODE="${1:-}"
case "$MODE" in
    ""|--check|--ci) ;;
    *) fail "usage: hanzo [--check|--ci]" ;;
esac

HANZO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

cd "$HANZO_DIR"

# A dry run must not mutate the checkout and CI must test the code
# under review — sync only on a real attended run.
if [ -z "$MODE" ]; then
    log "Syncing checkout to origin/main..."
    git fetch origin main
    git reset --hard origin/main
fi

# hanzo owns the pin: bootstrap only guarantees uv, so install here
# before the first Ansible call. `uv tool install` is idempotent and
# replaces a stale constraint, so drift converges on every run.
log "Installing ansible-core ~=${ANSIBLE_CORE_VERSION}..."
uv tool install "ansible-core~=${ANSIBLE_CORE_VERSION}"

log "Refreshing Ansible collections..."
ansible-galaxy collection install -r requirements.yml

ARGS=()
if [ "$MODE" = "--check" ]; then
    ARGS+=(--check)
fi
# Prompt for sudo only when a terminal is reachable (curl | bash keeps
# stdin on the pipe, so probe /dev/tty instead of stdin) and never in CI.
if [ "$MODE" != "--ci" ] && { : </dev/tty; } 2>/dev/null; then
    ARGS+=(--ask-become-pass)
fi

log "Starting provisioner..."
ansible-playbook playbook.yml "${ARGS[@]}"

# AUR provisioning is Shelly's job, not Ansible's — a dry run has no
# Shelly equivalent, so --check skips it.
if [ "$MODE" != "--check" ]; then
    "$HANZO_DIR/bin/hanzo-aur" ${MODE:+"$MODE"}
fi
