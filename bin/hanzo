#!/usr/bin/env bash
# Hanzo CLI — converges the system with Ansible, then hands off to
# shelly-update for the attended AUR reconciliation.
#
# Usage: hanzo [--no-aur] [ansible-playbook-args...]
# Examples:
#   hanzo              # full run: converge, then attended AUR review
#   hanzo --check      # dry run (shows what would change; no AUR phase)
#   hanzo --no-aur     # converge only; run shelly-update later
#   hanzo --tags home  # selective run (no AUR phase)
#
# The AUR phase (bin/shelly-update) is attended by design: every
# package is reviewed by Claude and by a human before Shelly builds
# it. It runs automatically after full provisioning runs when a
# terminal is available; otherwise it is reported as pending.

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
log_info() { echo -e "${GREEN}[hanzo]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[hanzo]${NC} $1"; }

HANZO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# ---------------------------------------------------------------------------
# Argument parsing. `--no-aur` belongs to hanzo; everything else is
# passed to ansible-playbook untouched.
# ---------------------------------------------------------------------------
NO_AUR=0
LISTING=0
CHECK_MODE=0
SELECTIVE=0
ANSIBLE_ARGS=()

for arg in "$@"; do
    case "$arg" in
        --no-aur) NO_AUR=1; continue ;;
        --tags|-t|--tags=*|--skip-tags|--skip-tags=*) SELECTIVE=1 ;;
        --list-tags|--list-tasks|--list-hosts|--syntax-check) LISTING=1 ;;
        --check|-C) CHECK_MODE=1 ;;
    esac
    ANSIBLE_ARGS+=("$arg")
done

# ---------------------------------------------------------------------------
# Phase 1: system convergence (Ansible)
# ---------------------------------------------------------------------------
cd "$HANZO_DIR"

log_info "Syncing checkout to origin/main..."
git fetch origin main
git reset --hard origin/main

log_info "Refreshing Ansible collections..."
ansible-galaxy collection install -r requirements.yml

log_info "Starting provisioner..."
ansible-playbook playbook.yml --ask-become-pass "${ANSIBLE_ARGS[@]+"${ANSIBLE_ARGS[@]}"}"

# ---------------------------------------------------------------------------
# Phase 2: attended AUR reconciliation (bin/shelly-update). Full runs
# only — selective, listing, and check runs never touch AUR.
# ---------------------------------------------------------------------------
if [[ "$NO_AUR" -eq 0 && "$SELECTIVE" -eq 0 && "$LISTING" -eq 0 ]]; then
    if [[ "$CHECK_MODE" -eq 1 ]]; then
        log_info "Check mode — AUR reconciliation skipped. Run 'shelly-update' to review pending packages."
    elif [[ "${HANZO_AUR_UNATTENDED:-0}" == "1" ]] || { : </dev/tty; } 2>/dev/null; then
        "$HANZO_DIR/bin/shelly-update"
    else
        log_warn "No terminal available — AUR reconciliation pending. Run 'shelly-update' from a terminal."
    fi
fi
