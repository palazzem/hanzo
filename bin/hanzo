#!/usr/bin/env bash
# Hanzo CLI runs the Ansible provisioner.
# Usage: hanzo [ansible-playbook-args...]
# Examples:
#   hanzo              # full provisioning run
#   hanzo --check      # dry run (shows what would change)

set -euo pipefail

GREEN='\033[0;32m'
NC='\033[0m'
log_info() { echo -e "${GREEN}[hanzo]${NC} $1"; }

HANZO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

cd "$HANZO_DIR"

# HANZO_SKIP_SYNC=1 provisions the working tree as-is. Container tests
# set it: they must exercise the code under review, not origin/main.
if [[ "${HANZO_SKIP_SYNC:-0}" != "1" ]]; then
    log_info "Syncing checkout to origin/main..."
    git fetch origin main
    git reset --hard origin/main
fi

log_info "Refreshing Ansible collections..."
ansible-galaxy collection install -r requirements.yml

# --ask-become-pass needs a terminal to prompt on. Without one
# (container builds, CI) sudo must already be passwordless for the
# provisioning user, as tests/Containerfile configures.
become_args=()
if { : </dev/tty; } 2>/dev/null; then
    become_args=(--ask-become-pass)
fi

log_info "Starting provisioner..."
ansible-playbook playbook.yml "${become_args[@]+"${become_args[@]}"}" "$@"
