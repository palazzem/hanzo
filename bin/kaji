#!/usr/bin/env bash
# kaji — attended AUR package provisioning for Hanzo.
#
# Installs and updates ONLY the AUR packages declared in the Hanzo
# `<role>_aur` manifests, each one gated by every layer below. Any
# verification failure aborts the whole run immediately — there is no
# partial trust and no fallback path.
#
#   1. Claude gate: the claude CLI must be present (abort otherwise)
#      and logged in — `claude auth login` is started automatically
#      when it is not.
#   2. Trust keys: pinned upstream signing keys (trust/keys.conf) are
#      fetched sha256-pinned from the vendor, imported into the user
#      keyring, fingerprint-asserted, and cross-checked against an
#      independent keyserver.
#   3. Foreign-package check: every foreign (non-repo) package
#      installed on the system must be declared in the manifests;
#      unknown AUR packages abort.
#   4. Per package: the PKGBUILD (or its diff since the last approved
#      commit) is reviewed by Claude AND by a human — both are
#      mandatory; a Claude FAIL verdict or an unreadable verdict
#      aborts. Then the sources are verified (`makepkg
#      --verifysource`: checksums + PGP) with guards: no SKIP checksum
#      on non-signature sources (checked against the local filename
#      AND the URL, so `name::url` renames cannot evade it), no
#      validpgpkeys outside the pinned set, and signed packages
#      (trust/signed-packages.conf) must keep an actually-executed
#      signature verification: a detached .sig source for mode
#      "source", or kaji's own in-archive verification for mode
#      "embedded". Only then does Shelly build and install, pinned at
#      the exact approved commit.
#
# Shelly builds with `makepkg --skippgpcheck`; the verification above
# restores the PGP guarantee, and the PKGBUILD checksums (enforced by
# Shelly's build) bind the verified bytes to what gets installed.
#
# HANZO_AUR_UNATTENDED=1 skips only the Claude and human gates — it is
# reserved for CI and local container tests; never set it on a real
# host. Every cryptographic check still runs.

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'
log_info()  { echo -e "${GREEN}[kaji]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[kaji]${NC} $1"; }
log_error() { echo -e "${RED}[kaji]${NC} $1" >&2; }

HANZO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
KEYS_CONF="$HANZO_DIR/trust/keys.conf"
SIGNED_CONF="$HANZO_DIR/trust/signed-packages.conf"

STATE_DIR="$HOME/.local/state/hanzo"
STATE_FILE="$STATE_DIR/aur-reviewed"
CLONE_ROOT="$HOME/.cache/hanzo/aur"
UNATTENDED="${HANZO_AUR_UNATTENDED:-0}"

# ---------------------------------------------------------------------------
# Preconditions
# ---------------------------------------------------------------------------
if [[ "$(id -u)" -eq 0 ]]; then
    log_error "kaji must run as an unprivileged user (root masks Shelly build failures)."
    exit 1
fi
if ! command -v shelly >/dev/null 2>&1; then
    log_error "shelly is not installed — run 'hanzo' first (the system role installs it)."
    exit 1
fi
if [[ "$UNATTENDED" != "1" ]] && ! { : </dev/tty; } 2>/dev/null; then
    log_error "kaji requires a terminal: every AUR install is human-gated."
    exit 1
fi

# ---------------------------------------------------------------------------
# Gate 1: Claude. The automated review is mandatory, so the CLI must
# exist and be authenticated before anything else happens.
# ---------------------------------------------------------------------------
claude_logged_in() {
    # `claude auth status` reads local credentials (no network call).
    claude auth status --json 2>/dev/null | grep -q '"loggedIn": *true'
}

claude_gate() {
    [[ "$UNATTENDED" == "1" ]] && return 0
    if ! command -v claude >/dev/null 2>&1; then
        log_error "claude CLI not found — it is required for PKGBUILD review. Aborting."
        exit 1
    fi
    if ! claude_logged_in; then
        log_info "Claude login required for PKGBUILD review — starting 'claude auth login'..."
        claude auth login </dev/tty
        if ! claude_logged_in; then
            log_error "Claude login did not complete — aborting."
            exit 1
        fi
    fi
}

# ---------------------------------------------------------------------------
# Gate 2: pinned trust keys (ported from the former roles/trust
# dual-source pattern). Keys land in the user keyring: makepkg
# --verifysource reads it, and PKGBUILDs that verify in build() (e.g.
# 1password-cli's `gpg --verify op.sig op`) need it there too.
# ---------------------------------------------------------------------------
import_trust_keys() {
    local name fingerprint url asc_sha256 keyserver asc actual tmpring attempt recv_err
    while read -r name fingerprint url asc_sha256 keyserver; do
        [[ -z "$name" || "$name" == \#* ]] && continue

        # Converged fast path: the pinned fingerprint being present in
        # the user keyring is the exact postcondition of a successful
        # import — skip the vendor and keyserver round-trips, so
        # re-runs are local-only and a keyserver outage cannot abort
        # an already-provisioned host.
        if gpg --fingerprint --with-colons "$fingerprint" 2>/dev/null | grep -q "^fpr:::::::::${fingerprint}:$"; then
            log_info "trust: key '$name' already imported and pinned"
            continue
        fi

        asc="$(mktemp)"
        if ! curl -fsSL --retry 3 --retry-delay 5 --retry-connrefused --proto '=https' --tlsv1.2 -o "$asc" "$url"; then
            log_error "trust: failed to download key '$name' from $url"
            exit 1
        fi
        actual="$(sha256sum "$asc" | awk '{print $1}')"
        if [[ "$actual" != "$asc_sha256" ]]; then
            log_error "trust: key '$name' sha256 mismatch (expected $asc_sha256, got $actual)"
            exit 1
        fi

        # Independent second source: the keyserver copy must carry the
        # same full fingerprint.
        tmpring="$(mktemp -d)"
        chmod 0700 "$tmpring"
        # gpg exits 2 for both "network failed" and "key absent" —
        # retry to rule out flakes, and surface gpg's own message so
        # the highest-severity trust error is never a false alarm.
        recv_err=""
        for attempt in 1 2 3; do
            if recv_err="$(gpg --homedir "$tmpring" --keyserver "$keyserver" --recv-keys "$fingerprint" 2>&1)"; then
                recv_err=""
                break
            fi
            [[ "$attempt" -lt 3 ]] && sleep 5
        done
        if [[ -n "$recv_err" ]]; then
            log_error "trust: keyserver $keyserver did not return key '$name' ($fingerprint) after 3 attempts — network failure or missing key. gpg said:"
            printf '%s\n' "$recv_err" >&2
            rm -rf "$tmpring"
            exit 1
        fi
        if ! gpg --homedir "$tmpring" --fingerprint --with-colons "$fingerprint" | grep -q "^fpr:::::::::${fingerprint}:$"; then
            log_error "trust: keyserver copy of '$name' does not match pinned fingerprint"
            rm -rf "$tmpring"
            exit 1
        fi
        rm -rf "$tmpring"

        gpg --import "$asc" >/dev/null 2>&1 || true
        if ! gpg --fingerprint --with-colons "$fingerprint" 2>/dev/null | grep -q "^fpr:::::::::${fingerprint}:$"; then
            log_error "trust: imported key '$name' does not match pinned fingerprint $fingerprint"
            exit 1
        fi
        rm -f "$asc"
        log_info "trust: key '$name' verified (vendor sha256 + keyserver) and imported"
    done < "$KEYS_CONF"
}

pinned_fingerprints() {
    awk '!/^#/ && NF { print $2 }' "$KEYS_CONF"
}

signed_package_entry() { # <pkg> — prints "fingerprint mode [sigfile datafile]", if any
    awk -v p="$1" '!/^#/ && $1 == p { print $2, $3, $4, $5 }' "$SIGNED_CONF"
}

# ---------------------------------------------------------------------------
# Gate 3: foreign-package check — every foreign package on the system
# must be declared in the Hanzo manifests (debug split packages ride
# with their parent).
# ---------------------------------------------------------------------------
# Extracts every `<role>_aur` list from the role vars manifests with a
# real YAML parser — the same document model Ansible uses, so comments,
# quoting, and reformatting can never desync the manifests from the
# playbook. PyYAML comes from any python3 that has it, or from the
# ansible-core uv environment that bootstrap installs.
collect_aur_packages() {
    local py script
    script='
import glob, sys
import yaml
pkgs = []
for path in sorted(glob.glob(sys.argv[1] + "/roles/*/vars/main.yml")):
    with open(path) as fh:
        data = yaml.safe_load(fh) or {}
    for key, value in data.items():
        if key.endswith("_aur") and isinstance(value, list):
            pkgs.extend(str(item) for item in value)
print("\n".join(pkgs))
'
    if python3 -c "import yaml" >/dev/null 2>&1; then
        py="python3"
    elif command -v uv >/dev/null 2>&1 && [[ -x "$(uv tool dir)/ansible-core/bin/python" ]]; then
        py="$(uv tool dir)/ansible-core/bin/python"
    else
        log_error "No python with PyYAML available to parse the AUR manifests — stopping everything."
        exit 1
    fi
    "$py" -c "$script" "$HANZO_DIR"
}

foreign_package_check() { # <manifest newline-list>
    local manifest="$1" pkg base extras=() qm_out qm_rc=0
    # Fail closed: a pacman failure must abort, not read as "no
    # foreign packages". pacman may exit nonzero with empty output for
    # an empty query result — only nonzero WITH error output is a
    # failure.
    qm_out="$(pacman -Qmq 2>&1)" || qm_rc=$?
    if [[ "$qm_rc" -ne 0 && -n "$qm_out" ]]; then
        log_error "pacman -Qmq failed — cannot check foreign packages: $qm_out"
        exit 1
    fi
    while IFS= read -r pkg; do
        [[ -z "$pkg" ]] && continue
        grep -qx "$pkg" <<< "$manifest" && continue
        base="${pkg%-debug}"
        if [[ "$base" != "$pkg" ]] && grep -qx "$base" <<< "$manifest"; then
            continue
        fi
        extras+=("$pkg")
    done <<< "$qm_out"
    if [[ "${#extras[@]}" -gt 0 ]]; then
        log_error "Foreign packages installed but not in the Hanzo AUR manifests: ${extras[*]}"
        log_error "Remove them or add them to a role's <role>_aur list."
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
state_lookup() { # <pkg> — prints the last approved commit, if any
    if [[ -f "$STATE_FILE" ]]; then
        awk -v p="$1" '$1 == p { print $2 }' "$STATE_FILE"
    fi
}

state_record() { # <pkg> <sha>
    local tmp
    # Same-filesystem temp file so the mv is an atomic rename(2) — a
    # crash mid-record must never truncate the approval state.
    tmp="$(mktemp "$STATE_DIR/.aur-reviewed.XXXXXX")"
    if [[ -f "$STATE_FILE" ]]; then
        awk -v p="$1" '$1 != p' "$STATE_FILE" > "$tmp"
    fi
    echo "$1 $2" >> "$tmp"
    mv "$tmp" "$STATE_FILE"
}

# ---------------------------------------------------------------------------
# Gate 4a: Claude review — mandatory. A failed invocation, a missing
# verdict line, or a FAIL verdict aborts the entire run. No timeout:
# the review completes or the run stops.
# ---------------------------------------------------------------------------
# Pager may carry flags (PAGER='less -FRX'), and quitting it early
# must never kill the run. The content is a file, not a pipe, so an
# early quit cannot SIGPIPE the producer either.
page_file() { # <file>
    local -a pager_cmd
    read -ra pager_cmd <<< "${PAGER:-less}"
    "${pager_cmd[@]}" "$1" </dev/tty || true
}

claude_review() { # <pkg> <content-file> <subject>
    local pkg="$1" file="$2" subject="$3" review
    log_info "Claude security review (mandatory)..."
    if ! review="$(claude -p "Security-review this AUR ${subject} for package '${pkg}' before it is built and installed. Flag: changed source URLs or new domains; source renames via the 'name::url' syntax, especially .sig/.asc-named files that are consumed as data or executed rather than used as detached signatures; checksum edits without a matching version bump; removed or weakened signature verification (validpgpkeys, .sig sources, gpg --verify calls); network access or curl-piped shell in build()/package()/prepare() or .install scriptlets; writes outside \$pkgdir/\$srcdir; obfuscated or base64 payloads; added binary blobs; wrapper scripts around the packaged binary. Be terse. End with exactly one line: VERDICT: PASS|WARN|FAIL — <reason>." < "$file")"; then
        log_error "$pkg: Claude review failed to run — stopping everything."
        exit 1
    fi
    printf '%s\n' "$review"
    if ! printf '%s\n' "$review" | grep -qE 'VERDICT: *(PASS|WARN|FAIL)'; then
        log_error "$pkg: Claude review returned no verdict — stopping everything."
        exit 1
    fi
    if printf '%s\n' "$review" | grep -qE 'VERDICT: *FAIL'; then
        log_error "$pkg: Claude verdict is FAIL — stopping everything. Investigate before re-running."
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Gate 4b: source verification. Guards first, then makepkg
# --verifysource (checksums + PGP against the pinned user keyring).
# Any failure aborts the run.
# ---------------------------------------------------------------------------
verify_sources() { # <pkg> <clone>
    local pkg="$1" clone="$2" srcinfo bad fp required req_fpr req_mode req_sig req_data
    # --printsrcinfo sources the PKGBUILD; it runs only after review.
    srcinfo="$(cd "$clone" && makepkg --printsrcinfo)"

    # Guard: SKIP checksums are acceptable solely for detached
    # signature files — anything else would unbind our verification
    # from the bytes Shelly builds. A source entry counts as a
    # signature only when BOTH its local filename (left of a `::`
    # rename, else the URL basename) and its remote URL end in
    # .sig/.asc — matching the entry suffix alone is evadable via the
    # rename syntax (`payload::https://host/x.sig`).
    bad="$(awk -F' = ' '
        function is_sig(entry,    localname, url) {
            url = entry
            localname = entry
            if (match(entry, /::/)) {
                localname = substr(entry, 1, RSTART - 1)
                url = substr(entry, RSTART + 2)
            } else {
                sub(/[?#].*$/, "", localname)
                sub(/^.*\//, "", localname)
            }
            return (localname ~ /\.(sig|asc)$/ && url ~ /\.(sig|asc)([?#].*)?$/)
        }
        { sub(/^[ \t]+/, "") }
        $1 ~ /^source(_[a-zA-Z0-9_]+)?$/ {
            suffix = $1; sub(/^source/, "", suffix)
            src[suffix, ++nsrc[suffix]] = $2
        }
        $1 ~ /^(ck|md5|sha1|sha224|sha256|sha384|sha512|b2)sums(_[a-zA-Z0-9_]+)?$/ {
            type = $1
            suffix = type; sub(/^[a-z0-9]+sums/, "", suffix)
            idx = ++nsum[type]
            if ($2 == "SKIP") {
                s = src[suffix, idx]
                if (s == "" || !is_sig(s))
                    print (s == "" ? "<unknown source>" : s)
            }
        }' <<< "$srcinfo")"
    if [[ -n "$bad" ]]; then
        log_error "$pkg: SKIP checksum on non-signature source(s):"
        printf '%s\n' "$bad" >&2
        log_error "$pkg: stopping everything — handle this package manually."
        exit 1
    fi

    # Guard: every validpgpkeys entry must be one of our pinned keys —
    # a swapped signing key aborts instead of verifying against an
    # attacker-supplied key.
    while IFS= read -r fp; do
        [[ -z "$fp" ]] && continue
        if ! pinned_fingerprints | grep -qix "$fp"; then
            log_error "$pkg: PKGBUILD declares signing key $fp which is not pinned in trust/keys.conf — stopping everything."
            exit 1
        fi
    done < <(awk -F' = ' '{ sub(/^[ \t]+/, "") } $1 == "validpgpkeys" { print $2 }' <<< "$srcinfo")

    # Guard: signed packages must KEEP an actually-executed signature
    # verification. Declaring validpgpkeys is not enough: with no
    # detached .sig/.asc source, `makepkg --verifysource` never
    # consults it, and a PKGBUILD-internal `gpg --verify` in check()
    # is skipped under Shelly's --skippgpcheck (it sets makepkg's
    # SKIPPGPCHECK=1). Mode "source" requires a detached signature
    # source; mode "embedded" makes kaji verify the in-archive
    # signature itself after download.
    required="$(signed_package_entry "$pkg")"
    req_fpr="" req_mode="" req_sig="" req_data=""
    if [[ -n "$required" ]]; then
        read -r req_fpr req_mode req_sig req_data <<< "$required"
        if ! awk -F' = ' '{ sub(/^[ \t]+/, "") } $1 == "validpgpkeys" { print $2 }' <<< "$srcinfo" | grep -qix "$req_fpr"; then
            log_error "$pkg: upstream signs its artifacts, but the PKGBUILD no longer declares the pinned key $req_fpr in validpgpkeys — stopping everything."
            exit 1
        fi
        case "$req_mode" in
            source)
                if ! awk -F' = ' '
                    function is_sig(entry,    localname, url) {
                        url = entry; localname = entry
                        if (match(entry, /::/)) {
                            localname = substr(entry, 1, RSTART - 1)
                            url = substr(entry, RSTART + 2)
                        } else {
                            sub(/[?#].*$/, "", localname)
                            sub(/^.*\//, "", localname)
                        }
                        return (localname ~ /\.(sig|asc)$/ && url ~ /\.(sig|asc)([?#].*)?$/)
                    }
                    { sub(/^[ \t]+/, "") }
                    $1 ~ /^source(_[a-zA-Z0-9_]+)?$/ && is_sig($2) { found = 1 }
                    END { exit !found }' <<< "$srcinfo"; then
                    log_error "$pkg: signed package no longer ships a detached .sig/.asc source — makepkg would verify nothing. Stopping everything."
                    exit 1
                fi
                ;;
            embedded)
                if [[ -z "$req_sig" || -z "$req_data" ]]; then
                    log_error "$pkg: embedded mode requires sigfile and datafile in trust/signed-packages.conf — stopping everything."
                    exit 1
                fi
                ;;
            *)
                log_error "$pkg: unknown signature mode '$req_mode' in trust/signed-packages.conf — stopping everything."
                exit 1
                ;;
        esac
    fi

    log_info "$pkg: verifying sources (checksums + PGP signatures)..."
    if ! (cd "$clone" && makepkg --verifysource); then
        log_error "$pkg: source verification failed — stopping everything."
        exit 1
    fi

    if [[ "$req_mode" == "embedded" ]]; then
        verify_embedded_signature "$pkg" "$clone" "$srcinfo" "$req_fpr" "$req_sig" "$req_data"
    fi
}

# The signature travels inside the source archive: extract the
# downloaded (already checksum-verified) sources and verify the
# signature against the pinned key directly. gpg's VALIDSIG status
# line carries the signing (sub)key fingerprint and the primary key
# fingerprint — the pinned fingerprint must appear on it.
verify_embedded_signature() { # <pkg> <clone> <srcinfo> <fingerprint> <sigfile> <datafile>
    local pkg="$1" clone="$2" srcinfo="$3" fingerprint="$4" sigfile="$5" datafile="$6"
    local tmp localname status arch
    arch="$(uname -m)"
    tmp="$(mktemp -d)"
    while IFS= read -r localname; do
        [[ -z "$localname" ]] && continue
        [[ "$localname" =~ \.(sig|asc)$ ]] && continue
        if [[ -f "$clone/$localname" ]]; then
            if ! bsdtar -xf "$clone/$localname" -C "$tmp"; then
                log_error "$pkg: failed to extract source archive $localname — stopping everything."
                rm -rf "$tmp"
                exit 1
            fi
        fi
    done < <(awk -F' = ' -v archsuf="_$arch" '
        { sub(/^[ \t]+/, "") }
        $1 == "source" || $1 == "source" archsuf {
            entry = $2
            if (match(entry, /::/)) { print substr(entry, 1, RSTART - 1) }
            else { sub(/[?#].*$/, "", entry); sub(/^.*\//, "", entry); print entry }
        }' <<< "$srcinfo")
    if [[ ! -f "$tmp/$sigfile" || ! -f "$tmp/$datafile" ]]; then
        log_error "$pkg: embedded signature files '$sigfile'/'$datafile' not found in the extracted sources — stopping everything."
        rm -rf "$tmp"
        exit 1
    fi
    if ! status="$(gpg --status-fd 1 --verify "$tmp/$sigfile" "$tmp/$datafile" 2>/dev/null)"; then
        log_error "$pkg: embedded signature verification FAILED — stopping everything."
        rm -rf "$tmp"
        exit 1
    fi
    if ! grep -E '^\[GNUPG:\] VALIDSIG ' <<< "$status" | grep -q "$fingerprint"; then
        log_error "$pkg: embedded signature is valid but NOT made by the pinned key $fingerprint — stopping everything."
        rm -rf "$tmp"
        exit 1
    fi
    rm -rf "$tmp"
    log_info "$pkg: embedded signature verified against pinned key ($sigfile → $datafile)"
}

# ---------------------------------------------------------------------------
# Per-package reconciliation
# ---------------------------------------------------------------------------
process_package() { # <pkg> — sets RESULT to installed|current|skipped
    local pkg="$1"
    local clone="$CLONE_ROOT/$pkg" head reviewed short answer content subject repo_file
    RESULT=skipped

    if [[ ! -d "$clone/.git" ]]; then
        if ! git clone -q "https://aur.archlinux.org/${pkg}.git" "$clone"; then
            log_error "$pkg: AUR clone failed — stopping everything."
            exit 1
        fi
    fi
    if ! git -C "$clone" fetch -q origin; then
        log_error "$pkg: AUR fetch failed — stopping everything."
        exit 1
    fi
    # An empty repo clones successfully from aur.archlinux.org for ANY
    # name — catch it here or the rev-parse dies with a bare git fatal
    # naming neither kaji nor the package.
    head="$(git -C "$clone" rev-parse -q --verify origin/HEAD 2>/dev/null \
        || git -C "$clone" rev-parse -q --verify origin/master 2>/dev/null || true)"
    if [[ -z "$head" ]]; then
        log_error "$pkg: AUR repository is empty — package name typo, or package deleted from AUR. Stopping everything."
        exit 1
    fi
    short="${head:0:12}"
    reviewed="$(state_lookup "$pkg")"
    # A recorded commit can vanish from the clone (cache cleared and
    # the package re-submitted on AUR with fresh history, or a
    # corrupted state line): fall back to a full review instead of
    # dying on an unreachable object.
    if [[ -n "$reviewed" ]] && ! git -C "$clone" cat-file -e "${reviewed}^{commit}" 2>/dev/null; then
        log_warn "$pkg: recorded approved commit ${reviewed:0:12} not found in the AUR history — falling back to a full review."
        reviewed=""
    fi

    if pacman -Q "$pkg" >/dev/null 2>&1 && [[ "$reviewed" == "$head" ]]; then
        log_info "$pkg: up to date at $short"
        RESULT=current
        return 0
    fi

    git -C "$clone" checkout -q --detach "$head"

    if [[ "$UNATTENDED" != "1" ]]; then
        echo ""
        log_info "── ${pkg} @ ${short} ──"
        if [[ "$reviewed" == "$head" ]]; then
            # This exact commit already passed both review gates — the
            # package just isn't installed. Skip straight to the
            # install confirmation; the human gate always remains.
            log_info "Commit $short is already approved; the package is not installed."
        else
            content="$(mktemp)"
            if [[ -n "$reviewed" ]]; then
                subject="package repo diff"
                log_info "Changes since your last approved commit (${reviewed:0:12}):"
                git -C "$clone" diff "$reviewed" "$head" > "$content"
            else
                # First review covers EVERY file in the package repo:
                # .install scriptlets run as root at install time and
                # patches apply at build time, so they get the same
                # scrutiny as the PKGBUILD.
                subject="full package repo (all files)"
                log_info "New package — reviewing all repo files:"
                while IFS= read -r repo_file; do
                    {
                        echo "==== $repo_file"
                        git -C "$clone" show "$head:$repo_file"
                        echo ""
                    } >> "$content"
                done < <(git -C "$clone" ls-files)
            fi
            page_file "$content"
            claude_review "$pkg" "$content" "$subject"
            rm -f "$content"
        fi
        read -rp "Install $pkg at $short? [y/N] " answer </dev/tty
        if [[ ! "$answer" =~ ^[Yy]$ ]]; then
            log_warn "$pkg: skipped (not approved)"
            return 0
        fi
    fi

    verify_sources "$pkg" "$clone"

    log_info "$pkg: building and installing at $short via Shelly..."
    # Stdin from `yes` answers Shelly's own prompts (the gates above
    # are the real controls); process substitution avoids a pipefail
    # false negative from yes's SIGPIPE exit. sudo still prompts on
    # the tty.
    if ! shelly install aur "$pkg" --version "$head" < <(yes); then
        log_error "$pkg: Shelly install failed — stopping everything."
        exit 1
    fi
    state_record "$pkg" "$head"
    # Keep the cache at git-repo size: drop the verified source
    # artifacts, which would otherwise accrete every payload of every
    # approved update forever.
    git -C "$clone" clean -dfxq
    log_info "$pkg: installed"
    RESULT=installed
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
# Shelly first-run bug: its sudo-elevated half root-owns these dirs if
# they don't exist yet, breaking later unprivileged downloads.
mkdir -p "$HOME/.cache/Shelly" "$HOME/.local/share/Shelly"
mkdir -p "$STATE_DIR" "$CLONE_ROOT"

claude_gate
import_trust_keys

manifest="$(collect_aur_packages)"
if [[ -z "$manifest" ]]; then
    log_info "No AUR packages declared."
    exit 0
fi
foreign_package_check "$manifest"

mapfile -t packages <<< "$manifest"
log_info "Provisioning ${#packages[@]} AUR package(s): ${packages[*]}"

installed=()
current=()
skipped=()
for pkg in "${packages[@]}"; do
    process_package "$pkg"
    case "$RESULT" in
        installed) installed+=("$pkg") ;;
        current)   current+=("$pkg") ;;
        *)         skipped+=("$pkg") ;;
    esac
done

echo ""
log_info "Done: ${#installed[@]} installed, ${#current[@]} current, ${#skipped[@]} skipped"
if [[ "${#skipped[@]}" -gt 0 ]]; then
    log_warn "Skipped (re-run kaji to review again): ${skipped[*]}"
fi
